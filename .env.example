COHERE_API_KEY=your-cohere-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
QDRANT_URL=https://your-qdrant-cluster-url
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_PREFIX=sourcesage
# Optional. Used for new notebooks only; existing ones keep the model they were built with.
# embed-english-v3.0 (1024) or embed-v4.0 (1536, 1024, 512 or 256)
EMBEDDING_MODEL=embed-english-v3.0
EMBEDDING_DIM=1024

# Public demo only. Leave DEMO_MODE unset for local use and the evaluation.
# DEMO_MODE=true turns on per-visitor daily limits (in memory, best-effort),
# the demo note in the UI, and deletion of notebooks older than NOTEBOOK_TTL_HOURS.
DEMO_MODE=
DEMO_MAX_UPLOADS_PER_DAY=3
DEMO_MAX_QUESTIONS_PER_DAY=20
DEMO_MAX_QUESTIONS_TOTAL_PER_DAY=25
NOTEBOOK_TTL_HOURS=24
